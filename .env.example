# QRadar API Configuration
QRADAR_API_BASE_URL=https://qradar-instance.example.com/api
QRADAR_UI_BASE_URL=https://qradar-instance.example.com

# Authentication
QRADAR_API_TOKEN=your-api-token-here
QRADAR_AUTH_HEADER=SEC
QRADAR_API_VERSION=18.0

# TLS Configuration
QRADAR_TLS_VERIFY=true
QRADAR_CA_PATH=

# Server Configuration
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=1000